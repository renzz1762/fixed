# Isi di Netlify: Site configuration > Environment variables
# (kalau pakai Vercel: Project > Settings > Environment Variables). JANGAN commit file .env asli.

# Rahasia buat kirim notifikasi (/api/notif-send). Bikin string acak panjang.
NOTIF_SECRET=
# Kunci server-ke-server (biar preview link /play/xxx jalan). Bikin string acak panjang.
INTERNAL_KEY=
# Kunci AssemblyAI (fitur transkrip lirik otomatis). Kosong = fitur itu mati (lirik biasa tetap jalan).
ASSEMBLYAI_KEY=
# Domain tambahan yang boleh akses API, pisah koma. Isi kalau pakai domain sendiri.
ALLOWED_HOSTS=namakamu.my.id,www.namakamu.my.id
# (opsional) batas request per menit per IP
RATE_MAX=90
